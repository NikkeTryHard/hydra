from collections.abc import Buffer

class Arena:
    def __init__(self, seeds: list[int], workers: int = 4) -> None: ...
    def enable_telemetry(self) -> None: ...
    def telemetry(self) -> tuple[tuple[str, int], ...] | None: ...
    def batch(self) -> tuple[bytearray, bytearray, bytearray, bytearray]: ...
    def step(self, ids: Buffer) -> None: ...
    def outcomes(self) -> list[tuple[int, list[int], list[int]]]: ...
